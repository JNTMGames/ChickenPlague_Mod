class FSteamModEditorModule : public IModuleInterface
{
public:
    void StartupModule() override
    {
        FPropertyEditorModule& PropertyEditor = FModuleManager::LoadModuleChecked<FPropertyEditorModule>(TEXT("PropertyEditor"));
        PropertyEditor.RegisterCustomClassLayout(
            AChickenGamesCharacterModPreview::StaticClass()->GetFName(),
            FOnGetDetailCustomizationInstance::CreateStatic(&FChickenGamesPreviewDetails::MakeInstance));
        PropertyEditor.RegisterCustomClassLayout(
            AChickenGamesPlayerPropModPreview::StaticClass()->GetFName(),
            FOnGetDetailCustomizationInstance::CreateStatic(&FChickenGamesPreviewDetails::MakeInstance));
        PropertyEditor.NotifyCustomizationModuleChanged();
        // Editor module reloads (including Live Coding) can leave the old spawner's
        // Window-menu entry behind. Remove it first so one module always owns one entry.
        FGlobalTabmanager::Get()->UnregisterNomadTabSpawner(TabName);
        FGlobalTabmanager::Get()->RegisterNomadTabSpawner(TabName, FOnSpawnTab::CreateLambda([](const FSpawnTabArgs&){ return SNew(SDockTab).TabRole(ETabRole::NomadTab)[SNew(SChickenGamesModKitPanel)]; })).SetDisplayName(FText::FromString(TEXT("ChickenGames ModKit")));
        UToolMenus::RegisterStartupCallback(FSimpleMulticastDelegate::FDelegate::CreateLambda([](){ UToolMenu* Menu = UToolMenus::Get()->ExtendMenu(TEXT("LevelEditor.MainMenu.Tools")); Menu->AddMenuEntry(TEXT("ChickenGamesModKit"), FToolMenuEntry::InitMenuEntry(TEXT("OpenChickenGamesModKit"), FText::FromString(TEXT("ChickenGames ModKit")), FText::FromString(TEXT("根据开发者 DataTable 选择并构建 MOD 资源")), FSlateIcon(), FUIAction(FExecuteAction::CreateLambda([](){ FGlobalTabmanager::Get()->TryInvokeTab(TabName); })))); }));
    }
    void ShutdownModule() override
    {
        if (FModuleManager::Get().IsModuleLoaded(TEXT("PropertyEditor")))
        {
            FPropertyEditorModule& PropertyEditor = FModuleManager::GetModuleChecked<FPropertyEditorModule>(TEXT("PropertyEditor"));
            PropertyEditor.UnregisterCustomClassLayout(AChickenGamesCharacterModPreview::StaticClass()->GetFName());
            PropertyEditor.UnregisterCustomClassLayout(AChickenGamesPlayerPropModPreview::StaticClass()->GetFName());
            PropertyEditor.NotifyCustomizationModuleChanged();
        }
        UToolMenus::UnRegisterStartupCallback(this);
        UToolMenus::UnregisterOwner(this);
        FGlobalTabmanager::Get()->UnregisterNomadTabSpawner(TabName);
    }
};
IMPLEMENT_MODULE(FSteamModEditorModule, SteamModEditor)



