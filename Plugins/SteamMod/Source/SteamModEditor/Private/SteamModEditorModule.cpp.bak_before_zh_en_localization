    bool IsModId(const FString& Value)
    {
        if (Value.Len() < 3 || Value.Len() > 64) return false;
        for (TCHAR C : Value) if (!((C >= 'a' && C <= 'z') || (C >= '0' && C <= '9') || C == '_')) return false;
        return true;
    }

    TArray<FString> PathParts(const FString& Path)
    {
        TArray<FString> Parts;
        Path.ParseIntoArray(Parts, TEXT("/"), true);
        for (FString& Part : Parts) Part.TrimStartAndEndInline();
        Parts.RemoveAll([](const FString& Part){ return Part.IsEmpty(); });
        return Parts;
    }

