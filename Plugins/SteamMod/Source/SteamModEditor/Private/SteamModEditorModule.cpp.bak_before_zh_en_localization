        FString SlotLabel(FName SlotId) const
        {
            const FChickenGamesModSlotRow* Row = Definitions.Find(SlotId);
            if (!Row) return SlotId.ToString();
            FString Label = Row->MenuPath.Replace(TEXT("/"), TEXT(" → "));
            if (!Label.IsEmpty()) Label += TEXT(" → ");
            Label += Row->EntryName.IsEmpty() ? SlotId.ToString() : Row->EntryName.ToString();
            return Label;
        }

        void SaveCurrentMod() const
        {
            const FString File = CurrentModFile();
            IFileManager::Get().MakeDirectory(*FPaths::GetPath(File), true);
            TSharedRef<FJsonObject> Json = MakeShared<FJsonObject>();
            Json->SetNumberField(TEXT("schemaVersion"), 2);
            Json->SetStringField(TEXT("modId"), Id());
            Json->SetStringField(TEXT("projectType"), ProjectType);
            Json->SetStringField(TEXT("contentRoot"), Root() + TEXT("/"));
            Json->SetStringField(TEXT("slotTable"), SlotTableAsset.IsValid() ? SlotTableAsset.GetObjectPathString() : FString());
            Json->SetStringField(TEXT("resourcePreview"),ResourcePreviewBox.IsValid()?ResourcePreviewBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapName"),MapNameBox.IsValid()?MapNameBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapAuthor"),MapAuthorBox.IsValid()?MapAuthorBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapDescription"),MapDescriptionBox.IsValid()?MapDescriptionBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapVersion"),MapVersionBox.IsValid()?MapVersionBox->GetText().ToString():TEXT("1.0"));
            Json->SetStringField(TEXT("mapPreview"),MapPreviewBox.IsValid()?MapPreviewBox->GetText().ToString():FString());
            TArray<TSharedPtr<FJsonValue>> SavedSelections;
            for (const FName SlotId : ActiveSlots)
            {
                const FAssetData* Asset = Selections.Find(SlotId);
                if (!Asset || !Asset->IsValid()) continue;
                TSharedRef<FJsonObject> Entry = MakeShared<FJsonObject>();
                Entry->SetStringField(TEXT("slot"), SlotId.ToString());
                Entry->SetStringField(TEXT("asset"), Asset->GetObjectPathString());
                SavedSelections.Add(MakeShared<FJsonValueObject>(Entry));
            }
            Json->SetArrayField(TEXT("selections"), SavedSelections);
            FString Text;
            FJsonSerializer::Serialize(Json, TJsonWriterFactory<TCHAR, TPrettyJsonPrintPolicy<TCHAR>>::Create(&Text));
            FFileHelper::SaveStringToFile(Text, *File);
            if (IsModId(Id()))
            {
                IFileManager::Get().MakeDirectory(*ProjectsDirectory(), true);
                FFileHelper::SaveStringToFile(Text, *ProjectFile(Id()));
            }
        }

        void CreateModFolders() const
        {
            const FString Base = FPaths::Combine(FPaths::ProjectContentDir(), TEXT("Mods"), FolderName());
            IFileManager::Get().MakeDirectory(*Base, true);
            if (ProjectType == TEXT("map"))
            {
                IFileManager::Get().MakeDirectory(*FPaths::Combine(Base, TEXT("Maps")), true);
                IFileManager::Get().MakeDirectory(*FPaths::Combine(Base, TEXT("MapAssets")), true);
            }
            else
            {
                for (const TCHAR* Child : {TEXT("Animations"), TEXT("Sounds"), TEXT("Meshes"), TEXT("Materials"), TEXT("Textures"), TEXT("Effects"), TEXT("Character")})
                    IFileManager::Get().MakeDirectory(*FPaths::Combine(Base, Child), true);
            }
        }

        bool SetSlotTable(UDataTable* Table, bool bSave)
        {
            Definitions.Empty(); OrderedSlots.Empty(); ActiveSlots.Empty(); Selections.Empty(); SlotTableAsset = FAssetData();
            if (!Table || Table->GetRowStruct() != FChickenGamesModSlotRow::StaticStruct())
            {
                RebuildSlotList();
                if (Status.IsValid()) Status->SetText(FText::FromString(TEXT("请选择使用 ChickenGamesModSlotRow 行结构的 DataTable。")));
                return false;
            }
            SlotTableAsset = FAssetData(Table);
            TArray<FChickenGamesModSlotRow*> Rows;
            Table->GetAllRows(TEXT("ChickenGames ModKit"), Rows);
            TSet<FName> Seen;
            for (const FChickenGamesModSlotRow* Row : Rows)
            {
                if (!Row || Row->SlotId.IsNone() || Seen.Contains(Row->SlotId) || Row->MenuPath.IsEmpty() || Row->AllowedClass.IsNull())
                {
                    Definitions.Empty(); OrderedSlots.Empty(); RebuildSlotList();
                    if (Status.IsValid()) Status->SetText(FText::FromString(TEXT("配置表存在空路径、空类型或重复 SlotId。")));
                    return false;
                }
                Seen.Add(Row->SlotId); Definitions.Add(Row->SlotId, *Row); OrderedSlots.Add(Row->SlotId);
            }
            OrderedSlots.Sort([this](const FName& A, const FName& B)
            {
                const FChickenGamesModSlotRow& RA = Definitions[A]; const FChickenGamesModSlotRow& RB = Definitions[B];
                if (RA.SortOrder != RB.SortOrder) return RA.SortOrder < RB.SortOrder;
                return SlotLabel(A) < SlotLabel(B);
            });
            RebuildSlotList(); if (bSave) SaveCurrentMod();
            return !Definitions.IsEmpty();
        }

        void OnSlotTableChanged(const FAssetData& Asset)
        {
            if (SetSlotTable(Cast<UDataTable>(Asset.GetAsset()), true))
                Status->SetText(FText::FromString(FString::Printf(TEXT("已载入 %d 个可配置资源槽位。"), Definitions.Num())));
        }

        bool LoadCurrentMod()
        {
            FString Text; TSharedPtr<FJsonObject> Json; FString SavedId;
            if (!FFileHelper::LoadFileToString(Text, *CurrentModFile()) || !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Text), Json)
                || !Json.IsValid() || !Json->TryGetStringField(TEXT("modId"), SavedId) || !IsModId(SavedId)) return false;
            IdBox->SetText(FText::FromString(SavedId));
            if (!Json->TryGetStringField(TEXT("projectType"), ProjectType) || (ProjectType != TEXT("map") && ProjectType != TEXT("resource")))
            {
                FString LegacyMapName;
                ProjectType = Json->TryGetStringField(TEXT("mapName"), LegacyMapName) && !LegacyMapName.IsEmpty() ? TEXT("map") : TEXT("resource");
            }
            if (!FPaths::DirectoryExists(ProjectContentDirectory(SavedId))) return false;
            RefreshProjectTypeText();
            FString SavedValue;
            if(Json->TryGetStringField(TEXT("resourcePreview"),SavedValue) && ResourcePreviewBox.IsValid()) ResourcePreviewBox->SetText(FText::FromString(SavedValue));
            if(Json->TryGetStringField(TEXT("mapName"),SavedValue)) MapNameBox->SetText(FText::FromString(SavedValue));
            if(Json->TryGetStringField(TEXT("mapAuthor"),SavedValue)) MapAuthorBox->SetText(FText::FromString(SavedValue));
            if(Json->TryGetStringField(TEXT("mapDescription"),SavedValue)) MapDescriptionBox->SetText(FText::FromString(SavedValue));
            if(Json->TryGetStringField(TEXT("mapVersion"),SavedValue)) MapVersionBox->SetText(FText::FromString(SavedValue));
            if(Json->TryGetStringField(TEXT("mapPreview"),SavedValue)) MapPreviewBox->SetText(FText::FromString(SavedValue));
            FString TablePath;
            if (Json->TryGetStringField(TEXT("slotTable"), TablePath) && !TablePath.IsEmpty()) SetSlotTable(LoadObject<UDataTable>(nullptr, *TablePath), false);
            const TArray<TSharedPtr<FJsonValue>>* Items = nullptr;
            if (Json->TryGetArrayField(TEXT("selections"), Items)) for (const TSharedPtr<FJsonValue>& Item : *Items)
            {
                const TSharedPtr<FJsonObject>* Entry = nullptr; FString SlotText, AssetPath;
                if (Item->TryGetObject(Entry) && (*Entry)->TryGetStringField(TEXT("slot"), SlotText) && (*Entry)->TryGetStringField(TEXT("asset"), AssetPath))
                {
                    const FName SlotId(*SlotText); const FAssetData Asset(LoadObject<UObject>(nullptr, *AssetPath));
                    if (Definitions.Contains(SlotId) && Asset.IsValid()) { ActiveSlots.AddUnique(SlotId); Selections.Add(SlotId, Asset); }
                }
            }
            RebuildSlotList(); return true;
        }

        void GenerateModId(const FString& NewProjectType)
        {
            if (IsModId(Id())) SaveCurrentMod();
            ProjectType = NewProjectType;
            IdBox->SetText(FText::FromString(FGuid::NewGuid().ToString(EGuidFormats::Digits).ToLower()));
            ActiveSlots.Empty(); Selections.Empty(); LastOutputDirectory.Empty(); bMapPackagePrepared = false;
            if (ResourcePreviewBox.IsValid()) ResourcePreviewBox->SetText(FText::GetEmpty());
            if (MapNameBox.IsValid()) MapNameBox->SetText(FText::GetEmpty());
            if (MapAuthorBox.IsValid()) MapAuthorBox->SetText(FText::GetEmpty());
            if (MapDescriptionBox.IsValid()) MapDescriptionBox->SetText(FText::GetEmpty());
            if (MapVersionBox.IsValid()) MapVersionBox->SetText(FText::FromString(TEXT("1.0")));
            if (MapPreviewBox.IsValid()) MapPreviewBox->SetText(FText::GetEmpty());
            CreateModFolders(); RefreshProjectTypeText();
            if (OutputPathText.IsValid()) OutputPathText->SetText(FText::FromString(TEXT("尚未收集 MOD。")));
            RebuildSlotList(); SaveCurrentMod();
            Status->SetText(FText::FromString(TEXT("已创建") + ProjectTypeLabel() + TEXT("。资源目录：") + Root() + TEXT("/")));
        }

        FReply CreateResourceProject() { GenerateModId(TEXT("resource")); return FReply::Handled(); }
        FReply CreateMapProject() { GenerateModId(TEXT("map")); return FReply::Handled(); }

        void LoadProjectFile(FString File)
        {
            if (IsModId(Id())) SaveCurrentMod();
            FString Text;
            if (!FFileHelper::LoadFileToString(Text, *File) || !FFileHelper::SaveStringToFile(Text, *CurrentModFile()) || !LoadCurrentMod())
            {
                Status->SetText(FText::FromString(TEXT("无法载入 MOD 项目：") + File));
                return;
            }
            LastOutputDirectory.Empty();
            const FString ExistingOutput = OutputDirectory();
            if (FPaths::DirectoryExists(ExistingOutput))
            {
                LastOutputDirectory = ExistingOutput;
                OutputPathText->SetText(FText::FromString(TEXT("已输出：") + ExistingOutput));
            }
            else OutputPathText->SetText(FText::FromString(TEXT("尚未收集 MOD。")));
            Status->SetText(FText::FromString(TEXT("已切换到") + ProjectTypeLabel() + TEXT("：") + Id()));
        }

        TSharedRef<SWidget> BuildProjectMenu()
        {
            FMenuBuilder Menu(true, nullptr);
            TArray<FString> Files;
            IFileManager::Get().FindFiles(Files, *(ProjectsDirectory() / TEXT("*.json")), true, false);
            Files.Sort();
            bool bAddedProject = false;
            for (const FString& Name : Files)
            {
                const FString File = FPaths::Combine(ProjectsDirectory(), Name);
                FString Text; TSharedPtr<FJsonObject> Json; FString SavedId, SavedType;
                if (!FFileHelper::LoadFileToString(Text, *File) || !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Text), Json) || !Json.IsValid() || !Json->TryGetStringField(TEXT("modId"), SavedId)) continue;
                Json->TryGetStringField(TEXT("projectType"), SavedType);
                if (!IsModId(SavedId) || !FPaths::DirectoryExists(ProjectContentDirectory(SavedId))) continue;
                bAddedProject = true;
                const FString Label = SavedId + (SavedType == TEXT("map") ? TEXT("  [地图]") : TEXT("  [资源]"));
                Menu.AddMenuEntry(FText::FromString(Label), FText::FromString(File), FSlateIcon(), FUIAction(FExecuteAction::CreateSP(this, &SChickenGamesModKitPanel::LoadProjectFile, File)));
            }
            if (!bAddedProject) Menu.AddMenuEntry(FText::FromString(TEXT("还没有已保存项目")), FText::GetEmpty(), FSlateIcon(), FUIAction());
            return Menu.MakeWidget();
        }
        FReply CreateExampleTable()
        {
            const FString PackagePath(TEXT("/Game/ModKitReference")); const FString AssetName(TEXT("DT_ModSlots"));
            UDataTable* Table = LoadObject<UDataTable>(nullptr, *(PackagePath + TEXT("/") + AssetName + TEXT(".") + AssetName));
            if (!Table)
            {
                UDataTableFactory* Factory = NewObject<UDataTableFactory>(); Factory->Struct = FChickenGamesModSlotRow::StaticStruct();
                Table = Cast<UDataTable>(FModuleManager::LoadModuleChecked<FAssetToolsModule>(TEXT("AssetTools")).Get().CreateAsset(AssetName, PackagePath, UDataTable::StaticClass(), Factory));
            }
            if (!Table || Table->GetRowStruct() != FChickenGamesModSlotRow::StaticStruct())
            { Status->SetText(FText::FromString(TEXT("无法创建示例配置表，目标位置可能已有其他类型资产。"))); return FReply::Handled(); }
            if (Table->GetRowMap().IsEmpty())
            {
                auto Add = [Table](const TCHAR* RowName, const TCHAR* Path, const TCHAR* Entry, const TCHAR* Slot, UClass* Class, int32 Order)
                {
                    FChickenGamesModSlotRow Row; Row.MenuPath = Path; Row.EntryName = FText::FromString(Entry); Row.SlotId = FName(Slot);
                    Row.AllowedClass = TSoftClassPtr<UObject>(Class); Row.SortOrder = Order; Table->AddRow(FName(RowName), Row);
                };
                Add(TEXT("YuJieSinging"), TEXT("人物/雨姐坤/音效/唱歌音效"), TEXT("singing"), TEXT("character.yujie.audio.singing"), USoundBase::StaticClass(), 10);
                Add(TEXT("LaoDaWalk"), TEXT("人物/牢大坤/动画/走路动画"), TEXT("walkAnim"), TEXT("character.laoda.animation.walk"), UAnimSequence::StaticClass(), 20);
                Add(TEXT("LaoDaSinging"), TEXT("人物/牢大坤/音效/唱歌音效"), TEXT("singing"), TEXT("character.laoda.audio.singing"), USoundBase::StaticClass(), 30);
                Table->MarkPackageDirty();
            }
            SetSlotTable(Table, true);
            Status->SetText(FText::FromString(TEXT("已创建并载入 /Game/ModKitReference/DT_ModSlots，请保存并由开发者编辑表格。")));
            return FReply::Handled();
        }

        void ActivateSlot(FName SlotId)
        {
            if (ProjectType == TEXT("map")) { Status->SetText(FText::FromString(TEXT("地图项目不配置游戏资源替换；请新建或切换到资源替换 MOD。"))); return; }
            ActiveSlots.AddUnique(SlotId); RebuildSlotList(); SaveCurrentMod(); Status->SetText(FText::FromString(TEXT("已添加：") + SlotLabel(SlotId)));
        }

        FReply RemoveSlot(FName SlotId)
        {
            ActiveSlots.Remove(SlotId); Selections.Remove(SlotId); RebuildSlotList(); SaveCurrentMod(); return FReply::Handled();
        }

        void BuildMenuLevel(FMenuBuilder& Menu, const TArray<FString>& Prefix)
        {
            TArray<FString> Branches;
            for (const FName SlotId : OrderedSlots)
            {
                const TArray<FString> Parts = PathParts(Definitions[SlotId].MenuPath);
                bool bMatches = Parts.Num() >= Prefix.Num();
                for (int32 Index = 0; bMatches && Index < Prefix.Num(); ++Index) bMatches = Parts[Index] == Prefix[Index];
                if (!bMatches) continue;
                if (Parts.Num() > Prefix.Num()) Branches.AddUnique(Parts[Prefix.Num()]);
                else
                {
                    const FChickenGamesModSlotRow& Row = Definitions[SlotId];
                    const FString Leaf = Row.EntryName.IsEmpty() ? SlotId.ToString() : Row.EntryName.ToString();
                    Menu.AddMenuEntry(FText::FromString(Leaf), Row.Description, FSlateIcon(), FUIAction(FExecuteAction::CreateSP(this, &SChickenGamesModKitPanel::ActivateSlot, SlotId)));
                }
            }
            Branches.Sort();
            for (const FString& Branch : Branches)
            {
                TArray<FString> ChildPrefix = Prefix; ChildPrefix.Add(Branch);
                Menu.AddSubMenu(FText::FromString(Branch), FText::GetEmpty(), FNewMenuDelegate::CreateLambda([this, ChildPrefix](FMenuBuilder& Child){ BuildMenuLevel(Child, ChildPrefix); }));
            }
        }

        TSharedRef<SWidget> BuildSlotMenu()
        {
            FMenuBuilder Menu(true, nullptr); BuildMenuLevel(Menu, TArray<FString>());
            if (Definitions.IsEmpty()) Menu.AddMenuEntry(FText::FromString(TEXT("请先选择或创建槽位配置表")), FText::GetEmpty(), FSlateIcon(), FUIAction());
            return Menu.MakeWidget();
        }

        void RebuildSlotList()
        {
            if (!SlotList.IsValid()) return;
            SlotList->ClearChildren();
            if (ActiveSlots.IsEmpty()) { SlotList->AddSlot().AutoHeight().Padding(0,4)[SNew(STextBlock).Text(FText::FromString(TEXT("尚未添加资源槽位。")))]; return; }
            for (const FName SlotId : ActiveSlots)
            {
                const FChickenGamesModSlotRow* Row = Definitions.Find(SlotId); if (!Row) continue;
                UClass* Allowed = Row->AllowedClass.LoadSynchronous();
                SlotList->AddSlot().AutoHeight().Padding(0,8)[SNew(SVerticalBox)
                    +SVerticalBox::Slot().AutoHeight()[SNew(STextBlock).Text(FText::FromString(SlotLabel(SlotId) + (Row->bRequired ? TEXT("（必填）") : TEXT(""))))]
                    +SVerticalBox::Slot().AutoHeight().Padding(0,4)[SNew(SHorizontalBox)
                        +SHorizontalBox::Slot().FillWidth(1.0f).Padding(0,0,8,0)[SNew(SObjectPropertyEntryBox).AllowedClass(Allowed ? Allowed : UObject::StaticClass())
                            .ObjectPath_Lambda([this, SlotId](){ const FAssetData* A = Selections.Find(SlotId); return A && A->IsValid() ? A->GetObjectPathString() : FString(); })
                            .OnObjectChanged_Lambda([this, SlotId](const FAssetData& A){ if (A.IsValid()) Selections.Add(SlotId, A); else Selections.Remove(SlotId); SaveCurrentMod(); Status->SetText(FText::FromString(A.IsValid() ? TEXT("已选择：") + A.GetObjectPathString() : TEXT("已清除资源。"))); })]
                        +SHorizontalBox::Slot().AutoWidth()[SNew(SButton).Text(FText::FromString(TEXT("移除"))).OnClicked(this, &SChickenGamesModKitPanel::RemoveSlot, SlotId)]]];
            }
        }

        bool Validate(FString& Error) const
        {
            if (!IsModId(Id())) { Error = TEXT("MOD ID 无效。"); return false; }
            if (Definitions.IsEmpty()) { Error = TEXT("请先选择槽位配置表。"); return false; }
            if (Selections.IsEmpty()) { Error = TEXT("至少选择一个资源。"); return false; }
            for (const FName SlotId : OrderedSlots)
            {
                const FChickenGamesModSlotRow& Row = Definitions[SlotId]; const FAssetData* Asset = Selections.Find(SlotId);
                if (Row.bRequired && (!Asset || !Asset->IsValid())) { Error = TEXT("缺少必填资源：") + SlotLabel(SlotId); return false; }
            }
            for (const auto& Pair : Selections)
            {
                const FChickenGamesModSlotRow* Row = Definitions.Find(Pair.Key); UClass* Allowed = Row ? Row->AllowedClass.LoadSynchronous() : nullptr; UObject* Object = Pair.Value.GetAsset();
                if (!Row || !Allowed || !Object || !Object->IsA(Allowed)) { Error = TEXT("资源类型与配置表不匹配：") + Pair.Key.ToString(); return false; }
                if (!Pair.Value.PackagePath.ToString().StartsWith(Root() + TEXT("/"))) { Error = FString::Printf(TEXT("资源必须放在 %s/ 内：%s"), *Root(), *Pair.Value.GetObjectPathString()); return false; }
            }
            return true;
        }

        FReply Prepare()
        {
            if (ProjectType != TEXT("resource")) { Status->SetText(FText::FromString(TEXT("当前是地图项目。请切换到资源替换 MOD 后再准备资源分包。"))); return FReply::Handled(); }
            FString Error; if (!Validate(Error)) { Status->SetText(FText::FromString(Error)); return FReply::Handled(); }
            const FString PackagePath = Root(); const FString AssetName = TEXT("PAL_") + Id();
            UPrimaryAssetLabel* Label = LoadObject<UPrimaryAssetLabel>(nullptr, *(PackagePath + TEXT("/") + AssetName + TEXT(".") + AssetName));
            if (!Label)
            {
                UDataAssetFactory* Factory = NewObject<UDataAssetFactory>(); Factory->DataAssetClass = UPrimaryAssetLabel::StaticClass();
                Label = Cast<UPrimaryAssetLabel>(FModuleManager::LoadModuleChecked<FAssetToolsModule>(TEXT("AssetTools")).Get().CreateAsset(AssetName, PackagePath, UPrimaryAssetLabel::StaticClass(), Factory));
            }
            if (!Label) { Status->SetText(FText::FromString(TEXT("无法创建 PrimaryAssetLabel。"))); return FReply::Handled(); }
            Label->Modify(); Label->Rules.Priority = 1; Label->Rules.ChunkId = 1001; Label->Rules.bApplyRecursively = true; Label->Rules.CookRule = EPrimaryAssetCookRule::AlwaysCook;
            Label->bLabelAssetsInMyDirectory = true; Label->bIsRuntimeLabel = true; Label->MarkPackageDirty(); Label->UpdateAssetBundleData();
