        bool BuildCleanNamespacePak(const FString& SourcePak, const FString& CleanPak, FString& Error) const
        {
            const FString WorkRoot = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/PakSanitize"), FGuid::NewGuid().ToString(EGuidFormats::Digits));
            const FString ExtractRoot = FPaths::Combine(WorkRoot, TEXT("Extracted"));
            IFileManager::Get().MakeDirectory(*ExtractRoot, true);
            const FString UnrealPak = FPaths::ConvertRelativePathToFull(FPaths::Combine(FPaths::EngineDir(), TEXT("Binaries/Win64/UnrealPak.exe")));
            int32 ReturnCode = -1; FString StdOut, StdErr;
            const FString ExtractArgs = FString::Printf(TEXT("\"%s\" -Extract \"%s\""), *SourcePak, *ExtractRoot);
            if (!FPaths::FileExists(UnrealPak) || !FPlatformProcess::ExecProcess(*UnrealPak, *ExtractArgs, &ReturnCode, &StdOut, &StdErr) || ReturnCode != 0)
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Error = TEXT("无法提取分包：") + StdErr; return false;
            }
            const FString NamespaceRelative = FPaths::Combine(FApp::GetProjectName(), TEXT("Content/Mods"), FolderName());
            const FString NamespaceSource = FPaths::Combine(ExtractRoot, NamespaceRelative);
            TArray<FString> NamespaceFiles;
            IFileManager::Get().FindFilesRecursive(NamespaceFiles, *NamespaceSource, TEXT("*"), true, false);
            if (NamespaceFiles.IsEmpty())
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Error = TEXT("打包结果中没有当前 MOD 命名空间：") + Root(); return false;
            }
            const FString ResponseFile = FPaths::Combine(WorkRoot, TEXT("PakResponse.txt"));
            FString ResponseText;
            for (FString SourceFile : NamespaceFiles)
            {
                FPaths::NormalizeFilename(SourceFile);
                FString Relative = SourceFile.Mid(NamespaceSource.Len()); Relative.RemoveFromStart(TEXT("/"));
                const FString MountFile = FString::Printf(TEXT("../../../%s/Content/Mods/%s/%s"), FApp::GetProjectName(), *FolderName(), *Relative);
                ResponseText += FString::Printf(TEXT("\"%s\" \"%s\"\r\n"), *SourceFile, *MountFile);
            }
            if (!FFileHelper::SaveStringToFile(ResponseText, *ResponseFile))
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Error = TEXT("无法写入干净 Pak 的文件清单。"); return false;
            }
            IFileManager::Get().Delete(*CleanPak, false, true);
            ReturnCode = -1; StdOut.Empty(); StdErr.Empty();
            const FString CreateArgs = FString::Printf(TEXT("\"%s\" -Create=\"%s\" -compress"), *CleanPak, *ResponseFile);
            const bool bCreated = FPlatformProcess::ExecProcess(*UnrealPak, *CreateArgs, &ReturnCode, &StdOut, &StdErr) && ReturnCode == 0 && FPaths::FileExists(CleanPak);
            IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
            if (!bCreated) { Error = TEXT("创建命名空间独立的 Pak 失败：") + StdErr; return false; }
            return true;
        }
