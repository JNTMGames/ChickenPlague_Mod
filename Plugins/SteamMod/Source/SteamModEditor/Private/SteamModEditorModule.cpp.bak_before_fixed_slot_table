        void BuildMenuLevel(FMenuBuilder& Menu, const TArray<FString>& Prefix)
        {
            TArray<FString> Branches;
            for (const FName SlotId : OrderedSlots)
            {
                const TArray<FString> Parts = PathParts(Definitions[SlotId].MenuPath);
                bool bMatches = Parts.Num() >= Prefix.Num();
                for (int32 Index = 0; bMatches && Index < Prefix.Num(); ++Index) bMatches = Parts[Index] == Prefix[Index];
                if (!bMatches) continue;
                if (Parts.Num() > Prefix.Num()) Branches.AddUnique(Parts[Prefix.Num()]);
                else
                {
                    const FChickenGamesModSlotRow& Row = Definitions[SlotId];
                    const FString Leaf = Row.EntryName.IsEmpty() ? SlotId.ToString() : Row.EntryName.ToString();
                    Menu.AddMenuEntry(ModKitText(Leaf), ModKitText(Row.Description.ToString()), FSlateIcon(), FUIAction(FExecuteAction::CreateSP(this, &SChickenGamesModKitPanel::ActivateSlot, SlotId)));
                }
            }
            Branches.Sort();
            for (const FString& Branch : Branches)
            {
                TArray<FString> ChildPrefix = Prefix; ChildPrefix.Add(Branch);
                Menu.AddSubMenu(ModKitText(Branch), FText::GetEmpty(), FNewMenuDelegate::CreateLambda([this, ChildPrefix](FMenuBuilder& Child){ BuildMenuLevel(Child, ChildPrefix); }));
            }
        }

