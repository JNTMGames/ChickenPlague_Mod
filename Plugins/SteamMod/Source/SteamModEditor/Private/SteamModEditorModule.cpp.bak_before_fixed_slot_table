        bool LoadCurrentMod()
        {
            FString Text; TSharedPtr<FJsonObject> Json; FString SavedId;
            if (!FFileHelper::LoadFileToString(Text, *CurrentModFile()) || !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Text), Json)
                || !Json.IsValid() || !Json->TryGetStringField(TEXT("modId"), SavedId) || !IsModId(SavedId)) return false;
            IdBox->SetText(ModKitText(SavedId));
            if (!Json->TryGetStringField(TEXT("projectType"), ProjectType) || (ProjectType != TEXT("map") && ProjectType != TEXT("resource")))
            {
                FString LegacyMapName;
                ProjectType = Json->TryGetStringField(TEXT("mapName"), LegacyMapName) && !LegacyMapName.IsEmpty() ? TEXT("map") : TEXT("resource");
            }
            if (!FPaths::DirectoryExists(ProjectContentDirectory(SavedId))) return false;
            RefreshProjectTypeText();
            FString SavedValue;
            if(Json->TryGetStringField(TEXT("resourcePreview"),SavedValue) && ResourcePreviewBox.IsValid()) ResourcePreviewBox->SetText(ModKitText(SavedValue));
            if(Json->TryGetStringField(TEXT("mapName"),SavedValue)) MapNameBox->SetText(ModKitText(SavedValue));
            if(Json->TryGetStringField(TEXT("mapAuthor"),SavedValue)) MapAuthorBox->SetText(ModKitText(SavedValue));
            if(Json->TryGetStringField(TEXT("mapDescription"),SavedValue)) MapDescriptionBox->SetText(ModKitText(SavedValue));
            if(Json->TryGetStringField(TEXT("mapVersion"),SavedValue)) MapVersionBox->SetText(ModKitText(SavedValue));
            if(Json->TryGetStringField(TEXT("mapPreview"),SavedValue)) MapPreviewBox->SetText(ModKitText(SavedValue));
            FString TablePath;
            if (Json->TryGetStringField(TEXT("slotTable"), TablePath) && !TablePath.IsEmpty()) SetSlotTable(LoadObject<UDataTable>(nullptr, *TablePath), false);
            const TArray<TSharedPtr<FJsonValue>>* Items = nullptr;
            if (Json->TryGetArrayField(TEXT("selections"), Items)) for (const TSharedPtr<FJsonValue>& Item : *Items)
            {
                const TSharedPtr<FJsonObject>* Entry = nullptr; FString SlotText, AssetPath;
                if (Item->TryGetObject(Entry) && (*Entry)->TryGetStringField(TEXT("slot"), SlotText) && (*Entry)->TryGetStringField(TEXT("asset"), AssetPath))
                {
                    const FName SlotId(*SlotText); const FAssetData Asset(LoadObject<UObject>(nullptr, *AssetPath));
                    if (Definitions.Contains(SlotId) && Asset.IsValid()) { ActiveSlots.AddUnique(SlotId); Selections.Add(SlotId, Asset); }
                }
            }
            RebuildSlotList(); return true;
        }

