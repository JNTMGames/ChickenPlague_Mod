        void RebuildSlotList()
        {
            if (!SlotList.IsValid()) return;
            SlotList->ClearChildren();
            if (ActiveSlots.IsEmpty()) { SlotList->AddSlot().AutoHeight().Padding(0,4)[SNew(STextBlock).Text(ModKitText(TEXT("尚未添加资源槽位。")))]; return; }
            for (const FName SlotId : ActiveSlots)
            {
                const FChickenGamesModSlotRow* Row = Definitions.Find(SlotId); if (!Row) continue;
                UClass* Allowed = Row->AllowedClass.LoadSynchronous();
                SlotList->AddSlot().AutoHeight().Padding(0,8)[SNew(SVerticalBox)
                    +SVerticalBox::Slot().AutoHeight()[SNew(STextBlock).Text(ModKitText(SlotLabel(SlotId) + (Row->bRequired ? TEXT("（必填）") : TEXT(""))))]
                    +SVerticalBox::Slot().AutoHeight().Padding(0,4)[SNew(SHorizontalBox)
                        +SHorizontalBox::Slot().FillWidth(1.0f).Padding(0,0,8,0)[SNew(SObjectPropertyEntryBox).AllowedClass(Allowed ? Allowed : UObject::StaticClass())
                            .ObjectPath_Lambda([this, SlotId](){ const FAssetData* A = Selections.Find(SlotId); return A && A->IsValid() ? A->GetObjectPathString() : FString(); })
                            .OnObjectChanged_Lambda([this, SlotId](const FAssetData& A){ if (A.IsValid()) Selections.Add(SlotId, A); else Selections.Remove(SlotId); SaveCurrentMod(); Status->SetText(ModKitText(A.IsValid() ? TEXT("已选择：") + A.GetObjectPathString() : TEXT("已清除资源。"))); })]
                        +SHorizontalBox::Slot().AutoWidth()[SNew(SButton).Text(ModKitText(TEXT("移除"))).OnClicked(this, &SChickenGamesModKitPanel::RemoveSlot, SlotId)]]];
            }
        }

        bool Validate(FString& Error) const
        {
            if (!IsModId(Id())) { Error = TEXT("MOD ID 无效。"); return false; }
            if (Definitions.IsEmpty()) { Error = TEXT("请先选择槽位配置表。"); return false; }
            if (Selections.IsEmpty()) { Error = TEXT("至少选择一个资源。"); return false; }
            for (const FName SlotId : OrderedSlots)
            {
                const FChickenGamesModSlotRow& Row = Definitions[SlotId]; const FAssetData* Asset = Selections.Find(SlotId);
                if (Row.bRequired && (!Asset || !Asset->IsValid())) { Error = TEXT("缺少必填资源：") + SlotLabel(SlotId); return false; }
            }
            for (const auto& Pair : Selections)
            {
                const FChickenGamesModSlotRow* Row = Definitions.Find(Pair.Key); UClass* Allowed = Row ? Row->AllowedClass.LoadSynchronous() : nullptr; UObject* Object = Pair.Value.GetAsset();
                if (!Row || !Allowed || !Object || !Object->IsA(Allowed)) { Error = TEXT("资源类型与配置表不匹配：") + Pair.Key.ToString(); return false; }
                if (!Pair.Value.PackagePath.ToString().StartsWith(Root() + TEXT("/"))) { Error = FString::Printf(TEXT("资源必须放在 %s/ 内：%s"), *Root(), *Pair.Value.GetObjectPathString()); return false; }
            }
            return true;
        }

        FReply Prepare()
        {
            if (ProjectType != TEXT("resource")) { Status->SetText(ModKitText(TEXT("当前是地图项目。请切换到资源替换 MOD 后再准备资源分包。"))); return FReply::Handled(); }
            FString Error; if (!Validate(Error)) { Status->SetText(ModKitText(Error)); return FReply::Handled(); }
            const FString PackagePath = Root(); const FString AssetName = TEXT("PAL_") + Id();
            UPrimaryAssetLabel* Label = LoadObject<UPrimaryAssetLabel>(nullptr, *(PackagePath + TEXT("/") + AssetName + TEXT(".") + AssetName));
            if (!Label)
            {
                UDataAssetFactory* Factory = NewObject<UDataAssetFactory>(); Factory->DataAssetClass = UPrimaryAssetLabel::StaticClass();
                Label = Cast<UPrimaryAssetLabel>(FModuleManager::LoadModuleChecked<FAssetToolsModule>(TEXT("AssetTools")).Get().CreateAsset(AssetName, PackagePath, UPrimaryAssetLabel::StaticClass(), Factory));
            }
            if (!Label) { Status->SetText(ModKitText(TEXT("无法创建 PrimaryAssetLabel。"))); return FReply::Handled(); }
            Label->Modify(); Label->Rules.Priority = 1; Label->Rules.ChunkId = 1001; Label->Rules.bApplyRecursively = true; Label->Rules.CookRule = EPrimaryAssetCookRule::AlwaysCook;
            Label->bLabelAssetsInMyDirectory = true; Label->bIsRuntimeLabel = true; Label->MarkPackageDirty(); Label->UpdateAssetBundleData();
            const FString PendingDir = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/Pending")); IFileManager::Get().MakeDirectory(*PendingDir, true);
            TSharedRef<FJsonObject> Json = MakeShared<FJsonObject>(); Json->SetNumberField(TEXT("schemaVersion"), 1); Json->SetStringField(TEXT("id"), Id());
            Json->SetStringField(TEXT("contentRoot"), Root() + TEXT("/")); Json->SetStringField(TEXT("modType"), TEXT("resource")); Json->SetStringField(TEXT("slotTable"), SlotTableAsset.GetObjectPathString());
            const FString Preview=ResourcePreviewBox.IsValid()?ResourcePreviewBox->GetText().ToString():FString();
            if(!Preview.IsEmpty())
            {
                const FString Ext=FPaths::GetExtension(Preview).ToLower();
                if(!FPaths::FileExists(Preview)||(Ext!=TEXT("png")&&Ext!=TEXT("jpg")&&Ext!=TEXT("jpeg")))
                { Status->SetText(ModKitText(TEXT("资源 MOD 预览图必须是存在的 PNG 或 JPG 文件。"))); return FReply::Handled(); }
                Json->SetStringField(TEXT("preview"),TEXT("preview.")+Ext);
            }
            TArray<TSharedPtr<FJsonValue>> Replacements;
            for (const FName SlotId : OrderedSlots)
            {
                const FAssetData* Asset = Selections.Find(SlotId); if (!Asset || !Asset->IsValid()) continue;
                TSharedRef<FJsonObject> Entry = MakeShared<FJsonObject>(); Entry->SetStringField(TEXT("slot"), SlotId.ToString()); Entry->SetStringField(TEXT("asset"), Asset->GetObjectPathString()); Replacements.Add(MakeShared<FJsonValueObject>(Entry));
            }
            Json->SetArrayField(TEXT("replacements"), Replacements); FString Text;
            FJsonSerializer::Serialize(Json, TJsonWriterFactory<TCHAR, TPrettyJsonPrintPolicy<TCHAR>>::Create(&Text));
            if (!FFileHelper::SaveStringToFile(Text, *FPaths::Combine(PendingDir, Id() + TEXT(".json")))) { Status->SetText(ModKitText(TEXT("无法写入待构建清单。"))); return FReply::Handled(); }
            Status->SetText(ModKitText(TEXT("已按配置表准备 Chunk 1001。请保存全部并执行 Windows 打包，然后点“收集 MOD”。"))); return FReply::Handled();
        }

        bool BuildCleanNamespacePak(const FString& SourcePak, const FString& CleanPak, FString& Error) const
        {
            const FString WorkRoot = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/PakSanitize"), FGuid::NewGuid().ToString(EGuidFormats::Digits));
            const FString ExtractRoot = FPaths::Combine(WorkRoot, TEXT("Extracted"));
            IFileManager::Get().MakeDirectory(*ExtractRoot, true);
            const FString UnrealPak = FPaths::ConvertRelativePathToFull(FPaths::Combine(FPaths::EngineDir(), TEXT("Binaries/Win64/UnrealPak.exe")));
            int32 ReturnCode = -1; FString StdOut, StdErr;
            const FString ExtractArgs = FString::Printf(TEXT("\"%s\" -Extract \"%s\""), *SourcePak, *ExtractRoot);
            if (!FPaths::FileExists(UnrealPak) || !FPlatformProcess::ExecProcess(*UnrealPak, *ExtractArgs, &ReturnCode, &StdOut, &StdErr) || ReturnCode != 0)
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Error = TEXT("无法提取分包：") + StdErr; return false;
            }
            const FString NamespaceRelative = FPaths::Combine(FApp::GetProjectName(), TEXT("Content/Mods"), FolderName());
            const FString NamespaceSource = FPaths::Combine(ExtractRoot, NamespaceRelative);
            TArray<FString> NamespaceFiles;
            IFileManager::Get().FindFilesRecursive(NamespaceFiles, *NamespaceSource, TEXT("*"), true, false);
            if (NamespaceFiles.IsEmpty())
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Error = TEXT("打包结果中没有当前 MOD 命名空间：") + Root(); return false;
            }
            const FString ResponseFile = FPaths::Combine(WorkRoot, TEXT("PakResponse.txt"));
            FString ResponseText;
            for (FString SourceFile : NamespaceFiles)
            {
                FPaths::NormalizeFilename(SourceFile);
                FString Relative = SourceFile.Mid(NamespaceSource.Len()); Relative.RemoveFromStart(TEXT("/"));
                const FString MountFile = FString::Printf(TEXT("../../../%s/Content/Mods/%s/%s"), FApp::GetProjectName(), *FolderName(), *Relative);
                ResponseText += FString::Printf(TEXT("\"%s\" \"%s\"\r\n"), *SourceFile, *MountFile);
            }
            if (!FFileHelper::SaveStringToFile(ResponseText, *ResponseFile))
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Error = TEXT("无法写入干净 Pak 的文件清单。"); return false;
            }
            IFileManager::Get().Delete(*CleanPak, false, true);
            ReturnCode = -1; StdOut.Empty(); StdErr.Empty();
            const FString CreateArgs = FString::Printf(TEXT("\"%s\" -Create=\"%s\" -compress"), *CleanPak, *ResponseFile);
            const bool bCreated = FPlatformProcess::ExecProcess(*UnrealPak, *CreateArgs, &ReturnCode, &StdOut, &StdErr) && ReturnCode == 0 && FPaths::FileExists(CleanPak);
            IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
            if (!bCreated) { Error = TEXT("创建命名空间独立的 Pak 失败：") + StdErr; return false; }
            return true;
        }
        FReply Collect()
        {
            FString Error; if (!Validate(Error)) { Status->SetText(ModKitText(Error)); return FReply::Handled(); }
            const FString Pending = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/Pending"), Id() + TEXT(".json")); FString PendingText; TSharedPtr<FJsonObject> Json;
            if (!FFileHelper::LoadFileToString(PendingText, *Pending) || !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(PendingText), Json) || !Json.IsValid()) { Status->SetText(ModKitText(TEXT("请先点“准备分包”。"))); return FReply::Handled(); }
            const FString Pak = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("StagedBuilds/Windows"), FApp::GetProjectName(), TEXT("Content/Paks/pakchunk1001-Windows.pak"));
            if (!FPaths::FileExists(Pak)) { Status->SetText(ModKitText(TEXT("没找到 pakchunk1001-Windows.pak，请先完成 Windows 打包。"))); return FReply::Handled(); }
            const FString Out = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/Build"), Id()); IFileManager::Get().MakeDirectory(*Out, true);
            const FString CleanPak = FPaths::Combine(Out, TEXT("resources.pak"));
            if (!BuildCleanNamespacePak(Pak, CleanPak, Error)) { Status->SetText(ModKitText(Error)); return FReply::Handled(); }
            Json->SetStringField(TEXT("packageKind"), TEXT("cooked-pak")); Json->SetStringField(TEXT("platform"), TEXT("Windows")); Json->SetStringField(TEXT("pak"), TEXT("resources.pak"));
            FString PreviewFile;
            if(Json->TryGetStringField(TEXT("preview"),PreviewFile)&&!PreviewFile.IsEmpty())
            {
                const FString Source=ResourcePreviewBox.IsValid()?ResourcePreviewBox->GetText().ToString():FString();
                if(IFileManager::Get().Copy(*FPaths::Combine(Out,PreviewFile),*Source,true,true)!=COPY_OK)
                { Status->SetText(ModKitText(TEXT("复制资源 MOD 预览图失败。"))); return FReply::Handled(); }
            }
            FString FinalText; FJsonSerializer::Serialize(Json.ToSharedRef(), TJsonWriterFactory<TCHAR, TPrettyJsonPrintPolicy<TCHAR>>::Create(&FinalText));
            if (!FFileHelper::SaveStringToFile(FinalText, *FPaths::Combine(Out, TEXT("manifest.json")))) { Status->SetText(ModKitText(TEXT("写入最终清单失败。"))); return FReply::Handled(); }
            LastOutputDirectory = FPaths::ConvertRelativePathToFull(Out); if (OutputPathText.IsValid()) OutputPathText->SetText(ModKitText(TEXT("已输出：") + LastOutputDirectory)); Status->SetText(ModKitText(TEXT("MOD 收集完成。"))); return FReply::Handled();
        }

        bool ValidateCurrentMap(FString& PackageName, FString& Error) const
        {
            UWorld* World = GEditor ? GEditor->GetEditorWorldContext().World() : nullptr;
            if (!World || !World->PersistentLevel) { Error = TEXT("请先在编辑器中打开地图。"); return false; }
            PackageName = World->GetOutermost()->GetName();
            if (!PackageName.StartsWith(Root() + TEXT("/Maps/")))
            {
                Error = TEXT("请将当前地图保存在 ") + Root() + TEXT("/Maps/ 中。"); return false;
            }
            if (World->GetOutermost()->IsDirty()) { Error = TEXT("请先保存当前地图。"); return false; }
            if (World->GetWorldPartition()) { Error = TEXT("第一版地图 MOD 仅支持非 World Partition 关卡。"); return false; }
            UBlueprint* MarkerBP = LoadObject<UBlueprint>(nullptr,
                TEXT("/Game/ModKitReference/MapItems/BP_MapActorsTransform.BP_MapActorsTransform"));
            UEnum* MarkerEnum = LoadObject<UEnum>(nullptr, TEXT("/Game/ModKitReference/E_MapItems.E_MapItems"));
            if (!MarkerBP || !MarkerBP->GeneratedClass || !MarkerEnum)
            {
                Error = TEXT("缺少 MapItemsActor 蓝图或 E_MapItems 枚举。"); return false;
            }
            // Blueprint enums often store entries as NewEnumerator0 while only the
            // display label says "None". E_MapItems reserves numeric value 0 for
            // None, so ignore that value regardless of the authored/internal name.
            constexpr int64 NoneValue = 0;
            TMap<int64, int32> Counts;
            int32 PlayerStartCount = 0;
            int32 NavMeshBoundsCount = 0;
            for (ULevel* Level : World->GetLevels())
            {
                if (!Level) continue;
                for (AActor* Actor : Level->Actors)
                {
                    if (!Actor) continue;
                    if (Actor->IsA<APlayerStart>()) ++PlayerStartCount;
                    if (Actor->IsA<ANavMeshBoundsVolume>()) ++NavMeshBoundsCount;
                    if (!Actor->IsA(MarkerBP->GeneratedClass)) continue;
                    bool bFoundEnum = false;
                    for (TFieldIterator<FProperty> It(Actor->GetClass()); It; ++It)
                    {
                        FProperty* Property = *It;
                        if (FByteProperty* Byte = CastField<FByteProperty>(Property))
                        {
                            if (Byte->Enum == MarkerEnum)
                            {
                                const int64 Value = Byte->GetPropertyValue_InContainer(Actor);
                                if (Value != NoneValue) ++Counts.FindOrAdd(Value);
                                bFoundEnum = true; break;
                            }
                        }
                        else if (FEnumProperty* EnumProperty = CastField<FEnumProperty>(Property))
                        {
                            if (EnumProperty->GetEnum() == MarkerEnum)
                            {
                                const void* Value = EnumProperty->ContainerPtrToValuePtr<void>(Actor);
                                const int64 EnumValue = EnumProperty->GetUnderlyingProperty()->GetSignedIntPropertyValue(Value);
                                if (EnumValue != NoneValue) ++Counts.FindOrAdd(EnumValue);
                                bFoundEnum = true; break;
                            }
                        }
                    }
                    if (!bFoundEnum) { Error = TEXT("MapItemsActor 缺少 E_MapItems 类型的可读属性。"); return false; }
                }
            }
            TArray<FString> Problems;
            if (PlayerStartCount < 1)
            {
                Problems.Add(TEXT("缺少 PlayerStart（玩家起始点 Actor，必须且只能放置 1 个）"));
            }
            else if (PlayerStartCount > 1)
            {
                Problems.Add(FString::Printf(TEXT("PlayerStart 数量为 %d；玩家起始点必须且只能放置 1 个"), PlayerStartCount));
            }
            if (NavMeshBoundsCount < 1)
            {
                Problems.Add(TEXT("缺少 NavMeshBoundsVolume（导航网格边界体积）"));
            }
            else
            {
                UNavigationSystemV1* NavSystem = FNavigationSystem::GetCurrent<UNavigationSystemV1>(World);
                ARecastNavMesh* RecastNavMesh = NavSystem
                    ? Cast<ARecastNavMesh>(NavSystem->GetDefaultNavDataInstance(FNavigationSystem::DontCreate))
                    : nullptr;
                if (!RecastNavMesh || RecastNavMesh->GetNavMeshTilesCount() <= 0)
                {
                    Problems.Add(TEXT("没有已生成的导航网格；请执行“构建 → 构建路径”并保存地图"));
                }
            }
            for (int32 Index = 0; Index < MarkerEnum->NumEnums(); ++Index)
            {
                const int64 Value = MarkerEnum->GetValueByIndex(Index);
                const FString Name = MarkerEnum->GetNameStringByIndex(Index);
                const FString DisplayName = MarkerEnum->GetDisplayNameTextByIndex(Index).ToString();
                if (Value == NoneValue || Name.Equals(TEXT("None"), ESearchCase::IgnoreCase) ||
                    DisplayName.Equals(TEXT("None"), ESearchCase::IgnoreCase) ||
                    DisplayName.Equals(TEXT("无"), ESearchCase::IgnoreCase) ||
                    Name.EndsWith(TEXT("_MAX")) || MarkerEnum->HasMetaData(TEXT("Hidden"), Index)) continue;
                const int32 Count = Counts.FindRef(Value);
                if (Count != 1)
                    Problems.Add(FString::Printf(TEXT("%s：%d 个，应为 1 个"), *MarkerEnum->GetDisplayNameTextByIndex(Index).ToString(), Count));
            }
            if (!Problems.IsEmpty())
            {
                Error = TEXT("地图标记检查失败：\n") + FString::Join(Problems, TEXT("\n"));
                return false;
            }
            return true;
        }

        FReply CheckMap()
        {
            FString PackageName, Error;
            if (!ValidateCurrentMap(PackageName, Error)) Status->SetText(ModKitText(Error));
            else Status->SetText(ModKitText(TEXT("地图检查通过：") + PackageName));
            return FReply::Handled();
        }

        FReply PrepareMap()
        {
            if (ProjectType != TEXT("map")) { Status->SetText(ModKitText(TEXT("当前是资源替换项目。请新建或切换到地图 MOD 后再准备地图分包。"))); return FReply::Handled(); }
            FString PackageName, Error;
            if (!IsModId(Id()) || !ValidateCurrentMap(PackageName, Error))
            {
                Status->SetText(ModKitText(Error.IsEmpty() ? TEXT("MOD ID 无效。") : Error));
                return FReply::Handled();
            }
            const FString AssetName = TEXT("PAL_") + Id();
            UPrimaryAssetLabel* Label = LoadObject<UPrimaryAssetLabel>(nullptr,
                *(Root() + TEXT("/") + AssetName + TEXT(".") + AssetName));
            if (!Label)
            {
                UDataAssetFactory* Factory = NewObject<UDataAssetFactory>();
                Factory->DataAssetClass = UPrimaryAssetLabel::StaticClass();
                Label = Cast<UPrimaryAssetLabel>(FModuleManager::LoadModuleChecked<FAssetToolsModule>(TEXT("AssetTools"))
                    .Get().CreateAsset(AssetName, Root(), UPrimaryAssetLabel::StaticClass(), Factory));
            }
            if (!Label) { Status->SetText(ModKitText(TEXT("无法创建地图分包标签。"))); return FReply::Handled(); }
            Label->Modify(); Label->Rules.Priority = 1; Label->Rules.ChunkId = 1001;
            Label->Rules.bApplyRecursively = true; Label->Rules.CookRule = EPrimaryAssetCookRule::AlwaysCook;
            Label->bLabelAssetsInMyDirectory = true; Label->bIsRuntimeLabel = true;
            Label->MarkPackageDirty(); Label->UpdateAssetBundleData();
            // Give shared reference assets an explicit chunk-0 owner, higher priority than the MOD label.
            const FString ReferencePath(TEXT("/Game/ModKitReference"));
            const FString ReferenceName(TEXT("PAL_ModKitReference"));
            UPrimaryAssetLabel* ReferenceLabel = LoadObject<UPrimaryAssetLabel>(nullptr,
                *(ReferencePath + TEXT("/") + ReferenceName + TEXT(".") + ReferenceName));
            if (!ReferenceLabel)
            {
                UDataAssetFactory* Factory = NewObject<UDataAssetFactory>();
                Factory->DataAssetClass = UPrimaryAssetLabel::StaticClass();
                ReferenceLabel = Cast<UPrimaryAssetLabel>(FModuleManager::LoadModuleChecked<FAssetToolsModule>(TEXT("AssetTools"))
                    .Get().CreateAsset(ReferenceName, ReferencePath, UPrimaryAssetLabel::StaticClass(), Factory));
            }
            if (!ReferenceLabel)
            {
                Status->SetText(ModKitText(TEXT("无法为 ModKitReference 创建公共资源分包标签。")));
                return FReply::Handled();
            }
            ReferenceLabel->Modify(); ReferenceLabel->Rules.Priority = 10; ReferenceLabel->Rules.ChunkId = 0;
            ReferenceLabel->Rules.bApplyRecursively = true; ReferenceLabel->Rules.CookRule = EPrimaryAssetCookRule::AlwaysCook;
            ReferenceLabel->bLabelAssetsInMyDirectory = true; ReferenceLabel->bIsRuntimeLabel = true;
            ReferenceLabel->MarkPackageDirty(); ReferenceLabel->UpdateAssetBundleData();
            const FString PendingDir = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/Pending"));
            IFileManager::Get().MakeDirectory(*PendingDir, true);
            TSharedRef<FJsonObject> Json = MakeShared<FJsonObject>();
            Json->SetNumberField(TEXT("schemaVersion"), 1);
            Json->SetStringField(TEXT("id"), Id());
            Json->SetStringField(TEXT("modType"), TEXT("map"));
            Json->SetStringField(TEXT("contentRoot"), Root() + TEXT("/"));
            Json->SetStringField(TEXT("map"), PackageName);
            const FString DisplayName=MapNameBox->GetText().ToString().TrimStartAndEnd();
            const FString Author=MapAuthorBox->GetText().ToString().TrimStartAndEnd();
            if(DisplayName.IsEmpty()||Author.IsEmpty()) { Status->SetText(ModKitText(TEXT("请填写地图名称和作者。"))); return FReply::Handled(); }
            Json->SetStringField(TEXT("displayName"),DisplayName);
            Json->SetStringField(TEXT("author"),Author);
            Json->SetStringField(TEXT("description"),MapDescriptionBox->GetText().ToString());
            Json->SetStringField(TEXT("version"),MapVersionBox->GetText().ToString().TrimStartAndEnd());
            const FString Preview=MapPreviewBox->GetText().ToString();
            if(!Preview.IsEmpty())
            {
                const FString Ext=FPaths::GetExtension(Preview).ToLower();
                if(!FPaths::FileExists(Preview)||(Ext!=TEXT("png")&&Ext!=TEXT("jpg")&&Ext!=TEXT("jpeg")))
                { Status->SetText(ModKitText(TEXT("预览图必须是存在的 PNG 或 JPG 文件。"))); return FReply::Handled(); }
                Json->SetStringField(TEXT("preview"),TEXT("preview.")+Ext);
            }
            Json->SetArrayField(TEXT("replacements"), {});
            FString Text;
            FJsonSerializer::Serialize(Json, TJsonWriterFactory<TCHAR, TPrettyJsonPrintPolicy<TCHAR>>::Create(&Text));
            if (!FFileHelper::SaveStringToFile(Text, *FPaths::Combine(PendingDir, Id() + TEXT(".json"))))
            {
                Status->SetText(ModKitText(TEXT("无法写入地图清单。"))); return FReply::Handled();
            }
            bMapPackagePrepared = true;
            Status->SetText(ModKitText(TEXT("地图已准备。请保存分包标签并执行 Windows 打包，再点“收集地图 MOD”。")));
            return FReply::Handled();
        }

        FReply CollectMap()
        {
            FString PackageName, Error;
            if (!ValidateCurrentMap(PackageName, Error)) { Status->SetText(ModKitText(Error)); return FReply::Handled(); }
            const FString Pending = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/Pending"), Id() + TEXT(".json"));
            FString PendingText; TSharedPtr<FJsonObject> Json; FString PreparedMap;
            if (!FFileHelper::LoadFileToString(PendingText, *Pending) ||
                !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(PendingText), Json) || !Json.IsValid() ||
                !Json->TryGetStringField(TEXT("map"), PreparedMap) || PreparedMap != PackageName)
            {
                Status->SetText(ModKitText(TEXT("请先对当前地图点击“准备地图分包”。"))); return FReply::Handled();
            }
            const FString Pak = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("StagedBuilds/Windows"),
                FApp::GetProjectName(), TEXT("Content/Paks/pakchunk1001-Windows.pak"));
            if (!FPaths::FileExists(Pak)) { Status->SetText(ModKitText(TEXT("没找到 pakchunk1001-Windows.pak，请先完成 Windows 打包。"))); return FReply::Handled(); }
            // The editor normally runs on PhysicalFile and does not install a
            // PakFile platform wrapper. FPakFile can inspect an archive directly
            // through the active physical platform file in that case.
            IPlatformFile* ReaderPlatform = &FPlatformFileManager::Get().GetPlatformFile();
            if (auto* PakPlatform = static_cast<FPakPlatformFile*>(FPlatformFileManager::Get().FindPlatformFile(TEXT("PakFile"))))
            {
                if (PakPlatform->GetLowerLevel()) ReaderPlatform = PakPlatform->GetLowerLevel();
            }
            TRefCountPtr<FPakFile> Inspection = new FPakFile(ReaderPlatform, *Pak, false);
            if (!Inspection->IsValid())
            {
                Status->SetText(ModKitText(TEXT("地图 pak 无效。"))); return FReply::Handled();
            }
            bool bHasMap = false;
            const FString ExpectedMap = PackageName.Mid(6) + TEXT(".umap");
            for (FPakFile::FFilenameIterator It(*Inspection); It; ++It)
            {
                const FString Entry = It.Filename();
                if (Entry.EndsWith(ExpectedMap)) bHasMap = true;
            }
            if (!bHasMap)
            {
                Status->SetText(ModKitText(TEXT("地图不在 pakchunk1001 中，请保存分包标签和地图后重新打包。")));
                return FReply::Handled();
            }
            const FString Out = OutputDirectory(); IFileManager::Get().MakeDirectory(*Out, true);
            const FString CleanPak = FPaths::Combine(Out, TEXT("resources.pak"));
            const FString WorkRoot = FPaths::Combine(FPaths::ProjectSavedDir(), TEXT("ChickenGamesModKit/PakSanitize"), FGuid::NewGuid().ToString(EGuidFormats::Digits));
            const FString ExtractRoot = FPaths::Combine(WorkRoot, TEXT("Extracted"));
            IFileManager::Get().MakeDirectory(*ExtractRoot, true);
            const FString UnrealPak = FPaths::ConvertRelativePathToFull(FPaths::Combine(FPaths::EngineDir(), TEXT("Binaries/Win64/UnrealPak.exe")));
            int32 ReturnCode = -1; FString StdOut, StdErr;
            const FString ExtractArgs = FString::Printf(TEXT("\"%s\" -Extract \"%s\""), *Pak, *ExtractRoot);
            if (!FPaths::FileExists(UnrealPak) || !FPlatformProcess::ExecProcess(*UnrealPak, *ExtractArgs, &ReturnCode, &StdOut, &StdErr) || ReturnCode != 0)
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Status->SetText(ModKitText(TEXT("无法提取分包以清理非 MOD 文件：") + StdErr)); return FReply::Handled();
            }
            const FString NamespaceRelative = FPaths::Combine(FApp::GetProjectName(), TEXT("Content/Mods"), FolderName());
            const FString NamespaceSource = FPaths::Combine(ExtractRoot, NamespaceRelative);
            TArray<FString> NamespaceFiles;
            IFileManager::Get().FindFilesRecursive(NamespaceFiles, *NamespaceSource, TEXT("*"), true, false);
            if (NamespaceFiles.IsEmpty())
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Status->SetText(ModKitText(TEXT("打包结果中没有当前 MOD 命名空间：") + Root())); return FReply::Handled();
            }
            const FString ResponseFile = FPaths::Combine(WorkRoot, TEXT("PakResponse.txt"));
            FString ResponseText;
            for (FString SourceFile : NamespaceFiles)
            {
                FPaths::NormalizeFilename(SourceFile);
                FString Relative = SourceFile.Mid(NamespaceSource.Len()); Relative.RemoveFromStart(TEXT("/"));
                const FString MountFile = FString::Printf(TEXT("../../../%s/Content/Mods/%s/%s"), FApp::GetProjectName(), *FolderName(), *Relative);
                ResponseText += FString::Printf(TEXT("\"%s\" \"%s\"\r\n"), *SourceFile, *MountFile);
            }
            if (!FFileHelper::SaveStringToFile(ResponseText, *ResponseFile))
            {
                IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
                Status->SetText(ModKitText(TEXT("无法写入干净 Pak 的文件清单。"))); return FReply::Handled();
            }
            IFileManager::Get().Delete(*CleanPak, false, true);
            ReturnCode = -1; StdOut.Empty(); StdErr.Empty();
            const FString CreateArgs = FString::Printf(TEXT("\"%s\" -Create=\"%s\" -compress"), *CleanPak, *ResponseFile);
            const bool bCreated = FPlatformProcess::ExecProcess(*UnrealPak, *CreateArgs, &ReturnCode, &StdOut, &StdErr) && ReturnCode == 0 && FPaths::FileExists(CleanPak);
            IFileManager::Get().DeleteDirectory(*WorkRoot, false, true);
            if (!bCreated)
            { Status->SetText(ModKitText(TEXT("创建命名空间独立的地图 Pak 失败：") + StdErr)); return FReply::Handled(); }
            Json->SetStringField(TEXT("packageKind"), TEXT("cooked-pak"));
            Json->SetStringField(TEXT("platform"), TEXT("Windows"));
            Json->SetStringField(TEXT("pak"), TEXT("resources.pak"));
            FString PreviewFile;
            if(Json->TryGetStringField(TEXT("preview"),PreviewFile)&&!PreviewFile.IsEmpty())
            {
                const FString Source=MapPreviewBox->GetText().ToString();
                if(IFileManager::Get().Copy(*FPaths::Combine(Out,PreviewFile),*Source,true,true)!=COPY_OK)
                { Status->SetText(ModKitText(TEXT("复制地图预览图失败。"))); return FReply::Handled(); }
            }
            FString FinalText;
            FJsonSerializer::Serialize(Json.ToSharedRef(), TJsonWriterFactory<TCHAR, TPrettyJsonPrintPolicy<TCHAR>>::Create(&FinalText));
            if (!FFileHelper::SaveStringToFile(FinalText, *FPaths::Combine(Out, TEXT("manifest.json"))))
            { Status->SetText(ModKitText(TEXT("写入地图清单失败。"))); return FReply::Handled(); }
            LastOutputDirectory = FPaths::ConvertRelativePathToFull(Out);
            if (OutputPathText.IsValid()) OutputPathText->SetText(ModKitText(TEXT("已输出：") + LastOutputDirectory));
            Status->SetText(ModKitText(TEXT("地图 MOD 已收集。请在正式独立游戏中测试。")));
            return FReply::Handled();
        }

        FReply OpenOutputDirectory()
        {
            const FString Directory = LastOutputDirectory.IsEmpty() ? OutputDirectory() : LastOutputDirectory;
            if (FPaths::DirectoryExists(Directory))
            {
                FPlatformProcess::ExploreFolder(*Directory);
                Status->SetText(ModKitText(TEXT("已打开输出目录。")));
            }
            else Status->SetText(ModKitText(TEXT("输出目录不存在，请先收集 MOD。")));
            return FReply::Handled();
        }

