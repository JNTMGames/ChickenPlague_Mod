        FString SlotLabel(FName SlotId) const
        {
            const FChickenGamesModSlotRow* Row = Definitions.Find(SlotId);
            if (!Row) return SlotId.ToString();
            FString Label = Row->MenuPath.Replace(TEXT("/"), TEXT(" → "));
            if (!Label.IsEmpty()) Label += TEXT(" → ");
            Label += Row->EntryName.IsEmpty() ? SlotId.ToString() : Row->EntryName.ToString();
            return Label;
        }

        void SaveCurrentMod() const
        {
            const FString File = CurrentModFile();
            IFileManager::Get().MakeDirectory(*FPaths::GetPath(File), true);
            TSharedRef<FJsonObject> Json = MakeShared<FJsonObject>();
            Json->SetNumberField(TEXT("schemaVersion"), 2);
            Json->SetStringField(TEXT("modId"), Id());
            Json->SetStringField(TEXT("projectType"), ProjectType);
            Json->SetStringField(TEXT("contentRoot"), Root() + TEXT("/"));
            Json->SetStringField(TEXT("slotTable"), SlotTableAsset.IsValid() ? SlotTableAsset.GetObjectPathString() : FString());
            Json->SetStringField(TEXT("resourcePreview"),ResourcePreviewBox.IsValid()?ResourcePreviewBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapName"),MapNameBox.IsValid()?MapNameBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapAuthor"),MapAuthorBox.IsValid()?MapAuthorBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapDescription"),MapDescriptionBox.IsValid()?MapDescriptionBox->GetText().ToString():FString());
            Json->SetStringField(TEXT("mapVersion"),MapVersionBox.IsValid()?MapVersionBox->GetText().ToString():TEXT("1.0"));
            Json->SetStringField(TEXT("mapPreview"),MapPreviewBox.IsValid()?MapPreviewBox->GetText().ToString():FString());
            TArray<TSharedPtr<FJsonValue>> SavedSelections;
            for (const FName SlotId : ActiveSlots)
            {
                const FAssetData* Asset = Selections.Find(SlotId);
                if (!Asset || !Asset->IsValid()) continue;
                TSharedRef<FJsonObject> Entry = MakeShared<FJsonObject>();
                Entry->SetStringField(TEXT("slot"), SlotId.ToString());
                Entry->SetStringField(TEXT("asset"), Asset->GetObjectPathString());
                SavedSelections.Add(MakeShared<FJsonValueObject>(Entry));
            }
            Json->SetArrayField(TEXT("selections"), SavedSelections);
            FString Text;
            FJsonSerializer::Serialize(Json, TJsonWriterFactory<TCHAR, TPrettyJsonPrintPolicy<TCHAR>>::Create(&Text));
            FFileHelper::SaveStringToFile(Text, *File);
            if (IsModId(Id()))
            {
                IFileManager::Get().MakeDirectory(*ProjectsDirectory(), true);
                FFileHelper::SaveStringToFile(Text, *ProjectFile(Id()));
            }
        }

